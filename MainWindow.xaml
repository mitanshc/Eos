<Window x:Name="EosMainWindow" x:Class="Eos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="EosMainWin" Height="450" Width="800" Cursor="Arrow">
    <Grid x:Name="Eos">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#f2f2f2" LastChildFill="True" Margin="0,0,0,2">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="5,3">
                <Button x:Name="BackButton" Content="←" Width="30" Margin="2"
                        Click="BackButton_Click" Cursor="Hand"/>
                <Button x:Name="ForwardButton" Content="→" Width="30" Margin="2"
                        Click="ForwardButton_Click" Cursor="Hand"/>
                <Button x:Name="RefreshButton" Content="⟳" Width="30" Margin="2"
                        Click="RefreshButton_Click"/>
                <Button x:Name="HomeButton" Content="🏠" Width="30" Margin="2"
                        Click="HomeButton_Click"/>
            
            </StackPanel>
            <Border Height="26"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="#CFCFCF"
                    Background="White"
                    Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBox x:Name="AddressBar"
                         GotFocus="AddressBar_GotFocus"
                         BorderThickness="0"
                         Background="Transparent"
                         DockPanel.Dock="Right"
                         Margin="0"
                         Height="26"
                         VerticalContentAlignment="Center"
                         KeyDown="AddressBar_KeyDown"
                         Text="https://www.microsoft.com" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                  VerticalScrollBarVisibility="Disabled"
                  Margin="0,8,38,0" VerticalAlignment="Center">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
            </ScrollViewer>

            <!-- + button OVERLAY at end -->
            <Button x:Name="NewTabButton" Content="+" Width="30" Height="20" VerticalAlignment="Center"
            Margin="0,8,8,0" Click="NewTabButton_Click" Cursor="Hand" HorizontalAlignment="Right"/>
        </Grid>


        <wv2:WebView2 x:Name="Browser" Grid.Row="2"/>

    </Grid>
</Window>
